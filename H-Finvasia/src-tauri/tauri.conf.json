{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "H-Finvasia",
  "version": "0.2.0",
  "identifier": "com.hfinvasia.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "H-Finvasia",
        "width": 1320,
        "height": 840,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "visible": true,
        "center": true,
        "focus": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Finvasia market terminal",
    "longDescription": "H-Finvasia: market watch, snap quote and instrument search over the local instrument master and live/replay feed.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
