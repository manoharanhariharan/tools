{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "H-Remote",
  "version": "0.1.0",
  "identifier": "com.hremote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "H-Remote",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "center": true,
        "focus": true,
        "dragDropEnabled": true
      },
      {
        "label": "launcher",
        "url": "index.html?window=launcher",
        "title": "H-Remote launcher",
        "width": 720,
        "height": 520,
        "minWidth": 520,
        "minHeight": 220,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false,
        "focus": false,
        "dragDropEnabled": false
      },
      {
        "label": "sessions",
        "url": "index.html?window=sessions",
        "title": "H-Remote sessions",
        "width": 980,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "center": false,
        "focus": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Cross-platform remote session manager",
    "longDescription": "H-Remote keeps remote desktops, terminals, file transfers and local tools together in a searchable catalog.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
